---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Explore CloudCover's AWS API, IAM, and Terraform provider data."
    />
    <title>CloudCover Data Browser</title>
  </head>
  <body>
    <a class="skip-link" href="#workspace">Skip to explorer</a>

    <header class="site-header">
      <div class="topbar">
        <a class="brand" href={import.meta.env.BASE_URL} aria-label="CloudCover home">CloudCover</a>
        <form class="search-form" role="search" onsubmit="return false">
          <label class="sr-only" for="search">Search CloudCover data</label>
          <div class="search-control">
            <span class="search-icon" aria-hidden="true">⌕</span>
            <input
              id="search"
              type="search"
              role="combobox"
              aria-autocomplete="list"
              aria-controls="suggestions"
              aria-expanded="false"
              aria-haspopup="listbox"
              autocomplete="off"
              disabled
              placeholder="Search APIs, IAM permissions, or Terraform resources"
            />
            <button id="clear-search" class="clear-search" type="button" aria-label="Clear search" hidden>
              Clear
            </button>
          </div>
          <ul id="suggestions" class="suggestions" role="listbox" aria-label="Search suggestions" hidden></ul>
          <p id="search-feedback" class="sr-only" aria-live="polite"></p>
        </form>
      </div>
    </header>

    <main id="workspace">
      <div id="explorer" class="workspace" data-base-url={import.meta.env.BASE_URL}>
        <div class="workspace-toolbar" aria-label="Explorer controls">
          <div class="version-control">
            <label for="terraform-version">Terraform provider version</label>
            <select id="terraform-version" disabled>
              <option>Loading versions…</option>
            </select>
          </div>
          <p id="load-status" class="status" aria-live="polite">Loading catalog data…</p>
        </div>

        <section id="welcome" class="welcome" aria-labelledby="welcome-title">
          <p class="eyebrow">Cloud data explorer</p>
          <h1 id="welcome-title">Find the connection between AWS APIs, IAM, and Terraform.</h1>
          <p>
            Search API actions and their IAM permissions, or explore the known API actions
            and permissions for each Terraform resource lifecycle.
          </p>
          <div class="examples" aria-label="Try an example search">
            <span>Try an example</span>
            <button type="button" class="example-button" data-query="s3:CopyObject">s3:CopyObject</button>
            <button type="button" class="example-button" data-query="s3:GetObject">s3:GetObject</button>
            <button type="button" class="example-button" data-query="aws_s3_bucket">aws_s3_bucket</button>
          </div>
        </section>

        <section id="detail" class="detail" aria-live="polite" tabindex="-1" hidden></section>

        <aside class="source-note" aria-label="Data provenance">
          Catalog mappings are generated from AWS service models and Terraform AWS provider snapshots.
        </aside>
      </div>
    </main>

    <script src="../scripts/explorer.ts"></script>
  </body>
</html>
