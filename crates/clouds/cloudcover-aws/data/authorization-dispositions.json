      "ARNFormats": [
        "arn:${Partition}:odb:${Region}:${Account}:exadb-vm-cluster/${ExadbVmClusterId}"
      ],
      "ConditionKeys": [
        "aws:ResourceTag/${TagKey}"
      ]
    }
  }
}
